public class Problem1 {
  static class SrmStudent {
  String name, regNo; int attendance;
  SrmStudent(String n,String r,int a){
    name=n;
    regNo=r;
    attendance=a;
  }
  void addAttendanceUpdate(int a){attendance=a;}
  boolean isEligible(){return attendance>=75;}
  // Static: average belongs to the whole class; eligibility belongs to one student.
  static double classAverage(SrmStudent[] s){int t=0;for(SrmStudent x:s)t+=x.attendance;return(double)t/s.length;}
 }
 public static void main(String[] args){
  SrmStudent[] s={new SrmStudent("Ravi","RA01",82),new SrmStudent("Anitha","RA02",68),new SrmStudent("Karthik","RA03",91),new SrmStudent("Meera","RA04",74),new SrmStudent("Suresh","RA05",60)};
  for(SrmStudent x:s)System.out.println(x.name+" - "+x.attendance+"% - "+(x.isEligible()?"Eligible":"Detained"));
  System.out.printf("Class average: %.1f%%%n",SrmStudent.classAverage(s));
 }
}
