public class Problem2 {
    private String tripId;
    private double totalFare;
    private int passengerCount;

    public Problem2(String tripId, double totalFare, int passengerCount) {
        if (totalFare < 0) throw new IllegalArgumentException("Fare cannot be negative");
        if (passengerCount <= 0) throw new IllegalArgumentException("Passenger count must be positive");
        this.tripId = tripId;
        this.totalFare = totalFare;
        this.passengerCount = passengerCount;
    }

    public Problem2(String tripId, double totalFare) {
        this(tripId, totalFare, 1);
    }

    public Problem2(String tripId) {
        this(tripId, 0.0, 2);
    }

    double[] fareBreakdown() {
        double[] result = new double[passengerCount];
        if (passengerCount == 0) return result;

        long totalPaise = Math.round(totalFare * 100);
        long base = totalPaise / passengerCount;
        long remainder = totalPaise % passengerCount;

        // The last shares receive the leftover paise, matching the sample.
        for (int i = 0; i < passengerCount; i++) {
            long share = base + (i >= passengerCount - remainder ? 1 : 0);
            result[i] = share / 100.0;
        }
        return result;
    }

    boolean isConfirmationOverdue(int confirmed, int expected) {
        return confirmed < expected;
    }

    public static void main(String[] args) {
        Problem2 f = new Problem2("TRIP001", 100000, 3);
        System.out.println(java.util.Arrays.toString(f.fareBreakdown()));

        Problem2 provisional = new Problem2("TRIP003");
        System.out.println(java.util.Arrays.toString(provisional.fareBreakdown()));
    }
}
