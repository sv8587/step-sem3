public class Problem3 {
    String routeCode, routeName;
    int priority;

    public Problem3(String routeCode, String routeName, int priority) {
        this.routeCode = routeCode;
        this.routeName = routeName;
        this.priority = priority;
    }

    public Problem3(String routeCode, String routeName) {
        this(routeCode, routeName, 1);
    }

    int compareTo(Problem3 other) {
        if (priority != other.priority)
            return Integer.compare(other.priority, priority);

        int codeCompare = routeCode.compareToIgnoreCase(other.routeCode);
        if (codeCompare != 0) return codeCompare;

        int nameCompare = Integer.compare(routeName.length(), other.routeName.length());
        if (nameCompare != 0) return nameCompare;

        return 0;
    }

    static Problem3[] rankRoutes(Problem3[] routes) {
        Problem3[] result = routes.clone();

        // Stable insertion sort; equal routes retain arrival order.
        for (int i = 1; i < result.length; i++) {
            Problem3 key = result[i];
            int j = i - 1;

            while (j >= 0 && result[j].compareTo(key) > 0) {
                result[j + 1] = result[j];
                j--;
            }
            result[j + 1] = key;
        }
        return result;
    }

    public static void main(String[] args) {
        Problem3[] routes = {
            new Problem3("RT205L", "Airport Express", 3),
            new Problem3("rt201j", "City Central", 4),
            new Problem3("RT299T", "Night Service")
        };

        for (Problem3 r : rankRoutes(routes))
            System.out.println(r.routeCode);
    }
}
