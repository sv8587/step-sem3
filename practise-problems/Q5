public class Problem5 {
    static {
        System.out.println("Fleet reconciliation engine initialized.");
    }

    static class BusTicketAccount {
        String bookingId;
        double ticketFare;

        BusTicketAccount(String bookingId, double ticketFare) {
            if (ticketFare < 0) throw new IllegalArgumentException("Fare cannot be negative");
            this.bookingId = bookingId;
            this.ticketFare = ticketFare;
        }

        BusTicketAccount(String bookingId) {
            this(bookingId, 0.0);
        }

        final double calculatePenalty(int minutesLate) {
            if (minutesLate < 0) throw new IllegalArgumentException("Late minutes cannot be negative");
            return ticketFare * minutesLate * 0.01;
        }
    }

    static class Sleeper extends BusTicketAccount {
        Sleeper(String id, double fare) { super(id, fare); }

        double settle(double amount) {
            return amount * 0.95; // sleeper gets a 5% settlement adjustment
        }
    }

    static void processAccount(BusTicketAccount account, double amount, int minutesLate) {
        if (account == null) return;

        double penalty = account.calculatePenalty(minutesLate);
        double settled = amount;

        if (account instanceof Sleeper)
            settled = ((Sleeper) account).settle(amount);

        System.out.println(account.bookingId + " | settled: Rs " + settled
                + " | penalty: Rs " + penalty);
    }

    static void processBatch(BusTicketAccount[] accounts, double[] amounts,
                             int[] minutesLateArray) {
        if (accounts == null || amounts == null || minutesLateArray == null)
            throw new IllegalArgumentException("Input arrays cannot be null");

        int n = Math.min(accounts.length, Math.min(amounts.length, minutesLateArray.length));
        int processed = 0, nulls = 0, sleeper = 0, regular = 0;
        double grandPenalty = 0;

        for (int i = 0; i < n; i++) {
            if (accounts[i] == null) {
                nulls++;
                continue;
            }

            processed++;
            if (accounts[i] instanceof Sleeper) sleeper++;
            else regular++;

            grandPenalty += accounts[i].calculatePenalty(minutesLateArray[i]);
            processAccount(accounts[i], amounts[i], minutesLateArray[i]);
        }

        System.out.println(processed + " processed | " + nulls + " null skipped"
                + " | " + sleeper + " sleeper | " + regular + " regular"
                + " | grand total penalties = Rs " + grandPenalty);
    }

    public static void main(String[] args) {
        BusTicketAccount[] accounts = {
            new Sleeper("BK001", 2000), null, new BusTicketAccount("BK002", 1200)
        };
        double[] amounts = {1200, 900, 700};
        int[] late = {10, 5, 0};

        processBatch(accounts, amounts, late);
    }
}
